# ============================================================
# Verdure — "Coco et Cam font pousser"
# Variables d'environnement — copier en .env et remplir les valeurs
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Dashboard > Settings > API
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_ANON_KEY

# ── Perenual (remplace Trefle.io) ────────────────────────────
# Gratuit jusqu'à 100 req/jour : https://perenual.com/api
VITE_PERENUAL_API_KEY=VOTRE_PERENUAL_API_KEY

# ── Côté Vercel (variables serveur — NE PAS préfixer VITE_) ──
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=VOTRE_SERVICE_ROLE_KEY
PERENUAL_API_KEY=VOTRE_PERENUAL_API_KEY

# ── Anthropic / Claude (optionnel) ───────────────────────────
VITE_ANTHROPIC_API_KEY=
